(plane_proxy) {
	request_body {
		max_size {$FILE_SIZE_LIMIT}
	}

  redir /spaces /spaces/ permanent
	reverse_proxy /spaces/* space:3000

  redir /god-mode /god-mode/ permanent
	reverse_proxy /god-mode/* admin:3000
	
	reverse_proxy /live/* live:3000

	# CLAWD-1096: forward the ORIGINAL X-Forwarded-Proto to the API (the host
	# Caddy terminates TLS for plane.vhs.box and sets it to https; direct
	# http://IP:3000 sends none → stays http). Plane's production settings honor
	# SECURE_PROXY_SSL_HEADER, so this makes request.scheme match the browser →
	# presigned upload/serve URLs use the right scheme (fixes the https
	# mixed-content upload block) and works on BOTH access paths.
	reverse_proxy /api/* api:8000 {
		header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
	}

	reverse_proxy /auth/* api:8000 {
		header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
	}

	reverse_proxy /static/* api:8000 {
		header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
	}

	# CLAWD-1096: object store = clawd-garage (MinIO CE is EOL). Host is
	# PRESERVED (NO header_up) — Plane presigns GET URLs for request.get_host()
	# (= plane.vhs.box), and Garage validates SigV4 strictly against the Host it
	# receives, so the proxy must pass the original Host through, not rewrite it.
	reverse_proxy /{$BUCKET_NAME}/* clawd-garage:3900
	reverse_proxy /{$BUCKET_NAME} clawd-garage:3900

	reverse_proxy /* web:3000
}

{
	{$CERT_EMAIL}
	acme_ca {$CERT_ACME_CA:https://acme-v02.api.letsencrypt.org/directory} 
	{$CERT_ACME_DNS}
	servers {
		max_header_size 25MB
		client_ip_headers X-Forwarded-For X-Real-IP
		trusted_proxies static {$TRUSTED_PROXIES:0.0.0.0/0}
	}
}

{$SITE_ADDRESS} {
	import plane_proxy
}